---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PreFooterCTA from "../../components/PreFooterCTA.astro";
import { getAdvogados, getArea, NOME_ESCRITORIO } from "../../lib/content";

const advogados = await getAdvogados();
const advogadosComAreas = await Promise.all(
  advogados.map(async (adv) => ({
    ...adv,
    areasDetalhe: await Promise.all(adv.areas.map((slug) => getArea(slug))),
  }))
);

function iniciais(nome: string) {
  return nome
    .split(" ")
    .filter((p) => p.length > 2)
    .slice(0, 2)
    .map((p) => p[0])
    .join("");
}
---

<BaseLayout
  title="Equipe"
  description={`Perfis fictícios para demonstrar a apresentação da equipe no projeto ${NOME_ESCRITORIO}.`}
>
  <section class="border-b border-line bg-paper">
    <div class="mx-auto max-w-3xl px-5 py-20 sm:px-8">
      <p class="mark-section font-mono text-xs uppercase tracking-wide text-rubrica">&nbsp;Equipe</p>
      <h1 class="mt-4 font-display text-4xl font-600 leading-tight text-ink sm:text-5xl">
        Perfis que ilustram a apresentação da equipe.
      </h1>
      <p class="mt-6 font-body text-lg leading-relaxed text-ink-soft">
        Os nomes, cargos e biografias abaixo são fictícios. Eles demonstram a organização de perfis;
        não identificam profissionais reais nem comprovam formação ou registro na OAB.
      </p>
    </div>
  </section>

  <section class="bg-paper">
    <div class="mx-auto max-w-4xl divide-y divide-line px-5 sm:px-8">
      {advogadosComAreas.map((adv) => (
        <div id={adv.slug} class="scroll-mt-24 py-12">
          <div class="flex flex-col gap-6 sm:flex-row sm:gap-8">
            <span class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-navy-soft font-display text-lg font-600 text-navy">
              {iniciais(adv.nome)}
            </span>
            <div>
              <h2 class="font-display text-2xl font-600 text-ink">{adv.nome}</h2>
              <p class="mt-1 font-mono text-xs text-ink-faint">{adv.cargo} · {adv.oab}</p>

              <p class="mt-4 max-w-xl font-body leading-relaxed text-ink-soft">{adv.bio}</p>

              <ul class="mt-4 space-y-1 font-body text-sm text-ink-faint">
                {adv.formacao.map((f) => (
                  <li>— {f}</li>
                ))}
              </ul>

              <div class="mt-5 flex flex-wrap gap-2">
                {adv.areasDetalhe.map((area) => area && (
                  <a
                    href={`/areas-de-atuacao/${area.slug}`}
                    class="rounded-full border border-line px-3 py-1 font-body text-xs text-ink-soft hover:border-rubrica hover:text-rubrica"
                  >
                    {area.nome}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <PreFooterCTA
    title="Quer falar com um de nós?"
    subtitle="Conte brevemente sua situação e retornamos com o advogado mais adequado ao seu caso."
  />
</BaseLayout>
