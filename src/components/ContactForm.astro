---
import { getAreas } from "../lib/content";

const areas = await getAreas();
---

<p id="demo-instrucao" class="mb-6 font-body text-sm text-ink-soft"><strong>Simulação sem envio.</strong> Use apenas dados fictícios. Os campos são validados neste navegador e não são enviados ou salvos pela aplicação.</p>
<noscript><p class="mb-5 text-rubrica">Ative o JavaScript para experimentar a simulação. Nenhum dado será enviado.</p></noscript>
<form id="form-contato" novalidate method="dialog" aria-describedby="demo-instrucao">
<fieldset id="demo-campos" disabled class="space-y-5">
<legend class="sr-only">Experimentar formulário demonstrativo</legend>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="nome" class="block font-mono text-xs uppercase tracking-wide text-ink-faint">Nome completo</label>
      <input
        id="nome"
        name="nome"
        type="text"
        required
        minlength="2"
        maxlength="120"
        autocomplete="off"
        class="mt-2 w-full rounded-sm border border-line bg-paper px-4 py-3 font-body text-ink placeholder:text-ink-faint focus:border-navy"
      />
    </div>
    <div>
      <label for="telefone" class="block font-mono text-xs uppercase tracking-wide text-ink-faint">Telefone / WhatsApp</label>
      <input
        id="telefone"
        name="telefone"
        type="tel"
        maxlength="30"
        required
        autocomplete="off"
        class="mt-2 w-full rounded-sm border border-line bg-paper px-4 py-3 font-body text-ink placeholder:text-ink-faint focus:border-navy"
      />
    </div>
  </div>

  <div>
    <label for="email" class="block font-mono text-xs uppercase tracking-wide text-ink-faint">E-mail</label>
    <input
      id="email"
      name="email"
      type="email"
      maxlength="254"
      required
      autocomplete="off"
      class="mt-2 w-full rounded-sm border border-line bg-paper px-4 py-3 font-body text-ink placeholder:text-ink-faint focus:border-navy"
    />
  </div>

  <div>
    <label for="area" class="block font-mono text-xs uppercase tracking-wide text-ink-faint">Área de interesse</label>
    <select
      id="area"
      name="area"
      required
      class="mt-2 w-full rounded-sm border border-line bg-paper px-4 py-3 font-body text-ink focus:border-navy"
    >
      <option value="">Selecione...</option>
      {areas.map((area) => (
        <option value={area.slug}>{area.nome}</option>
      ))}
      <option value="outro">Outro assunto</option>
    </select>
  </div>

  <div>
    <label for="mensagem" class="block font-mono text-xs uppercase tracking-wide text-ink-faint">
      Escreva uma situação fictícia
    </label>
    <textarea
      id="mensagem"
      name="mensagem"
      required
      minlength="10"
      maxlength="2000"
      rows="4"
      class="mt-2 w-full rounded-sm border border-line bg-paper px-4 py-3 font-body text-ink placeholder:text-ink-faint focus:border-navy"
    ></textarea>
  </div>

<label class="flex items-start gap-3 font-body text-sm text-ink-soft">
    <input
      id="consentimento"
      name="consentimento"
      type="checkbox"
      required
      class="mt-1 h-4 w-4 shrink-0 rounded-sm border-line accent-navy"
    />
    <span>
      Entendo que este formulário é uma simulação local e usarei apenas dados fictícios. Leia a
      <a href="/politica-de-privacidade" class="text-navy underline decoration-line underline-offset-2 hover:text-rubrica">
        Política de Privacidade
      </a> para conhecer o funcionamento da demonstração.
    </span>
  </label>

  <p id="form-erro" role="alert" class="hidden font-body text-sm text-rubrica"></p>

  <button
    type="submit"
    class="w-full rounded-sm bg-rubrica px-7 py-3.5 font-body font-500 text-paper transition-colors hover:bg-rubrica-deep sm:w-auto"
  >
    Simular solicitação
  </button>
</fieldset>
</form>

<script>
  import { contactSchema } from "../lib/contact";
  const form = document.querySelector<HTMLFormElement>("#form-contato");
  const erroEl = document.getElementById("form-erro");
  const fields = document.querySelector<HTMLFieldSetElement>("#demo-campos");
  if (fields) fields.disabled = false;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    form.querySelectorAll("[aria-invalid]").forEach((field) => {
      field.removeAttribute("aria-invalid");
      field.removeAttribute("aria-describedby");
    });
    if (erroEl) { erroEl.textContent = ""; erroEl.classList.add("hidden"); }
    const result = contactSchema.safeParse(Object.fromEntries(new FormData(form)));
    if (!result.success) {
      const issue = result.error.issues[0];
      if (erroEl) { erroEl.textContent = issue.message; erroEl.classList.remove("hidden"); }
      const field = form.elements.namedItem(String(issue.path[0]));
      if (field instanceof HTMLElement) {
        field.setAttribute("aria-invalid", "true");
        field.setAttribute("aria-describedby", "form-erro");
        field.focus();
      }
      return;
    }
    // Nenhum fetch, armazenamento, log ou dado na URL: apenas navegação local.
    form.reset();
    window.location.assign("/obrigado");
  });
</script>
