---
import type { FaqItem } from "../lib/types";

interface Props {
  itens: FaqItem[];
}

const { itens } = Astro.props;
---

<div class="divide-y divide-line border-y border-line">
  {itens.map((item) => (
    <details class="group py-5">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-500 text-ink marker:content-none">
        {item.pergunta}
        <span aria-hidden="true" class="shrink-0 font-mono text-lg text-rubrica transition-transform group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 max-w-2xl font-body text-sm leading-relaxed text-ink-soft">
        {item.resposta}
      </p>
    </details>
  ))}
</div>
