---
import { getAdvogados } from "../lib/content";

const advogados = (await getAdvogados()).slice(0, 3);

function iniciais(nome: string) {
  return nome
    .split(" ")
    .filter((p) => p.length > 2)
    .slice(0, 2)
    .map((p) => p[0])
    .join("");
}
---

<section class="bg-paper">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mark-section font-mono text-xs uppercase tracking-wide text-ink-faint">&nbsp;Exemplos de perfis</p>
        <h2 class="mt-4 max-w-xl font-display text-2xl font-600 leading-snug text-ink sm:text-3xl">
          Uma apresentação clara da equipe.
        </h2>
      </div>
      <a href="/equipe" class="font-body text-sm text-navy underline decoration-line underline-offset-4 hover:text-rubrica">
        Ver toda a equipe →
      </a>
    </div>

    <div class="mt-12 grid gap-8 sm:grid-cols-3">
      {advogados.map((adv) => (
        <a href={`/equipe#${adv.slug}`} class="group block border-t border-line pt-5">
          <span class="flex h-12 w-12 items-center justify-center rounded-full bg-navy-soft font-display text-sm font-600 text-navy">
            {iniciais(adv.nome)}
          </span>
          <h3 class="mt-4 font-display text-lg font-600 text-ink group-hover:text-rubrica">{adv.nome}</h3>
          <p class="font-mono text-xs text-ink-faint">{adv.cargo} · {adv.oab}</p>
          <p class="mt-2 font-body text-sm leading-relaxed text-ink-soft">{adv.formacao[0]}</p>
        </a>
      ))}
    </div>
  </div>
</section>
