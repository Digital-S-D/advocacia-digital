---
import { getReconhecimentos } from "../lib/content";

const reconhecimentos = await getReconhecimentos();

const numeros = [
  { valor: "15+", rotulo: "anos de atuação" },
  { valor: "6", rotulo: "áreas de atuação" },
  { valor: "40+", rotulo: "empresas atendidas em compliance" },
];
---

<section class="border-b border-line bg-paper-warm">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
      {numeros.map((n) => (
        <div class="flex items-baseline gap-3">
          <span class="font-display text-4xl font-600 text-navy">{n.valor}</span>
          <span class="font-body text-sm text-ink-soft">{n.rotulo}</span>
        </div>
      ))}
    </div>

    <div class="mt-10 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
      <p class="mark-section shrink-0 font-mono text-xs uppercase tracking-wide text-ink-faint">&nbsp;Reconhecimento</p>
      <ul class="flex flex-wrap gap-x-8 gap-y-2 font-body text-sm text-ink-soft">
        {reconhecimentos.map((r) => (
          <li>{r.titulo} — <span class="text-ink-faint">{r.organizacao}, {r.ano}</span></li>
        ))}
      </ul>
    </div>
  </div>
</section>
