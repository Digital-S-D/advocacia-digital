---
import { getAreas, getAdvogados, getConteudo } from "../lib/content";
const numeros = [
  { valor: (await getAreas()).length, rotulo: "áreas ilustrativas" },
  { valor: (await getAdvogados()).length, rotulo: "perfis fictícios" },
  { valor: (await getConteudo("blog")).length, rotulo: "artigos de exemplo" },
];
---
<section class="border-b border-line bg-paper-warm">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-3">
      {numeros.map((n) => <div class="flex items-baseline gap-3"><span class="font-display text-4xl font-600 text-navy">{n.valor}</span><span class="font-body text-sm text-ink-soft">{n.rotulo}</span></div>)}
    </div>
    <p class="mt-8 border-t border-line pt-6 font-body text-sm text-ink-soft">Elementos da demonstração. Não representam histórico de atuação, clientes, prêmios ou resultados de um escritório.</p>
  </div>
</section>
